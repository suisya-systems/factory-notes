{
  "name": "cal80-o3",
  "home": ".factory-cal80-o3",
  "steps": [
    {"exec":["npm", "test"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/calibrate-80/arms.ts", "--self-test"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/calibrate-80/arms.ts", "--precheck", "docs/calibrate-80/rules.json"]},
    {"factory":["probe-isolation", "cal80-o3-probe"]},
    {"factory":["draft", "stock-tasks-library-settle-cc-p", "--request", "requests/stock-tasks-library-settle.md"],"redraft":2},
    {"factory":["draft", "pay-ship-invoice-notify-cc-p", "--request", "requests/pay-ship-invoice-notify.md", "--service"],"redraft":2},
    {"factory":["draft", "shop-expense-rooms-board-cc-p", "--request", "requests/shop-expense-rooms-board.md", "--ui"],"redraft":2},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/calibrate-80/arms.ts", "--provenance", "{state}", "stock-tasks-library-settle-cc-p", "pay-ship-invoice-notify-cc-p", "shop-expense-rooms-board-cc-p"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/calibrate-80/arms.ts", "--placeholders", "{state}", "docs/calibrate-80/placeholders-screen-specs-o3.md", "stock-tasks-library-settle-cc-p", "pay-ship-invoice-notify-cc-p", "shop-expense-rooms-board-cc-p"]},
    {"gate":"screen-specs", "approve":["stock-tasks-library-settle-cc-p", "pay-ship-invoice-notify-cc-p", "shop-expense-rooms-board-cc-p"],"read":["docs/calibrate-80/placeholders-screen-specs-o3.md"],"fix":{"prereg/screen.json":"docs/calibrate-80/screen.json", "prereg/rules.json":"docs/calibrate-80/rules.json"}},
    {"factory":["draft", "stock-tasks-library-settle-cx-p", "--request", "requests/stock-tasks-library-settle.md", "--spec-from", "stock-tasks-library-settle-cc-p", "--model", "scenario-drafter=gpt-6-astra"],"redraft":2},
    {"factory":["draft", "pay-ship-invoice-notify-cx-p", "--request", "requests/pay-ship-invoice-notify.md", "--service", "--spec-from", "pay-ship-invoice-notify-cc-p", "--model", "scenario-drafter=gpt-6-astra"],"redraft":2},
    {"factory":["draft", "shop-expense-rooms-board-cx-p", "--request", "requests/shop-expense-rooms-board.md", "--ui", "--spec-from", "shop-expense-rooms-board-cc-p", "--model", "scenario-drafter=gpt-6-astra"],"redraft":2},
    {"exec":["cmp", "{state}/vault/stock-tasks-library-settle-cc-p/spec.md", "{state}/vault/stock-tasks-library-settle-cx-p/spec.md"]},
    {"exec":["cmp", "{state}/vault/pay-ship-invoice-notify-cc-p/spec.md", "{state}/vault/pay-ship-invoice-notify-cx-p/spec.md"]},
    {"exec":["cmp", "{state}/vault/shop-expense-rooms-board-cc-p/spec.md", "{state}/vault/shop-expense-rooms-board-cx-p/spec.md"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/calibrate-80/arms.ts", "--provenance", "{state}", "stock-tasks-library-settle-cx-p", "pay-ship-invoice-notify-cx-p", "shop-expense-rooms-board-cx-p"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/calibrate-80/arms.ts", "--placeholders", "{state}", "docs/calibrate-80/placeholders-screen-o3.md", "stock-tasks-library-settle-cx-p", "pay-ship-invoice-notify-cx-p", "shop-expense-rooms-board-cx-p"]},
    {"gate":"screen", "approve":["stock-tasks-library-settle-cx-p", "pay-ship-invoice-notify-cx-p", "shop-expense-rooms-board-cx-p"],"read":["docs/calibrate-80/placeholders-screen-o3.md"]},
    {"parallel":[{"factory":["replicate", "stock-tasks-library-settle-cc-p", "--k", "4", "--score", "stock-tasks-library-settle-cx-p", "--max-cost", "30"]},{"factory":["replicate", "pay-ship-invoice-notify-cc-p", "--k", "4", "--score", "pay-ship-invoice-notify-cx-p", "--max-cost", "30"]},{"factory":["replicate", "shop-expense-rooms-board-cc-p", "--k", "4", "--score", "shop-expense-rooms-board-cx-p", "--max-cost", "30"]}],"max":3},
    {"factory":["replicate", "stock-tasks-library-settle-cc-p", "--score", "stock-tasks-library-settle-cx-p", "--rescore"]},
    {"factory":["replicate", "pay-ship-invoice-notify-cc-p", "--score", "pay-ship-invoice-notify-cx-p", "--rescore"]},
    {"factory":["replicate", "shop-expense-rooms-board-cc-p", "--score", "shop-expense-rooms-board-cx-p", "--rescore"]},
    {"factory":["replicate", "stock-tasks-library-settle-cc-p", "--rescore", "--score", "stock-tasks-library-settle-cx-p"]},
    {"factory":["replicate", "pay-ship-invoice-notify-cc-p", "--rescore", "--score", "pay-ship-invoice-notify-cx-p"]},
    {"factory":["replicate", "shop-expense-rooms-board-cc-p", "--rescore", "--score", "shop-expense-rooms-board-cx-p"]},
    {"factory":["tally", "stock-tasks-library-settle-cc-p"],"always":true},
    {"factory":["tally", "pay-ship-invoice-notify-cc-p"],"always":true},
    {"factory":["tally", "shop-expense-rooms-board-cc-p"],"always":true},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/calibrate-80/arms.ts", "--screen", "{state}/prereg/screen.json", ".", "--stage", "measure", "--builder", "claude-opus-5-5", "stock-tasks-library-settle", "pay-ship-invoice-notify", "shop-expense-rooms-board"]}
  ]
}
